import sys

def solve():
    data = sys.stdin.buffer.read().split()
    idx = 0
    t = int(data[idx]); idx += 1
    out = []
    for _ in range(t):
        n, m = int(data[idx]), int(data[idx+1]); idx += 2
        produced = [False] * 26
        for _ in range(n):
            w = data[idx]; idx += 1
            produced[w[0] - ord('a')] = True
        abbrs = []
        for _ in range(m):
            a = data[idx]; idx += 1
            abbrs.append(a)

        created = [False] * m
        count = 0
        changed = True
        while changed:
            changed = False
            for i in range(m):
                if not created[i] and all(produced[c - ord('A')] for c in abbrs[i]):
                    created[i] = True
                    produced[abbrs[i][0] - ord('A')] = True
                    count += 1
                    changed = True

        out.append("YES" if count == m else "NO")
    print("\n".join(out))

solve()
